# Ejemplo de variables de entorno (sin valores reales).
# Next.js lee .env.local en desarrollo; en producción se definen en Vercel.

# URL pública, para las URL canónicas, el sitemap y los hreflang.
# Por defecto: https://mfloresr-portfolio.vercel.app
SITE_URL=

# Con 1, oculta los borradores del blog también fuera de producción (para probar).
OCULTAR_BORRADORES=

# Clave de la API de Gemini (Google AI Studio) para la página «Pregunta a la IA».
# Sin ella, esa función no está disponible. Nunca la subas al repositorio.
GEMINI_API_KEY=
