# Ejemplo de variables de entorno (sin valores reales).
# Next.js lee .env.local en desarrollo; en producción se definen en Vercel.

# URL pública, para las URL canónicas, el sitemap y los hreflang.
# Por defecto: https://mfloresr-portfolio.vercel.app
SITE_URL=

# Con 1, oculta los borradores del blog también fuera de producción (para probar).
OCULTAR_BORRADORES=

# Clave de la API de Gemini (Google AI Studio) para la página «Pregunta a la IA».
# Sin ella, esa función no está disponible. Nunca la subas al repositorio.
GEMINI_API_KEY=

# Formulario de contacto (Resend, https://resend.com).
# Clave de la API de Resend. Sin ella, el formulario muestra «no disponible» y ofrece el email.
RESEND_API_KEY=
# Correo que recibe los mensajes (por defecto, el email del perfil en content/perfil.yaml).
# Con el remitente de pruebas de Resend solo se entrega al correo con el que creaste la cuenta.
CONTACT_TO=
# Remitente (por defecto «Portfolio <onboarding@resend.dev>»). Con un dominio verificado en Resend
# puede ser, por ejemplo, «Portfolio <web@tudominio.com>».
CONTACT_FROM=
